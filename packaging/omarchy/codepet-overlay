#!/bin/sh
# codepet-overlay: verb launcher for the CodePet desktop pet.
#
#   codepet-overlay show|hide|toggle|refresh|status|card|quit [--force]
#
# 0.6: the desktop pet is the native `codepet-pet` (Wayland layer shell, a few MB, no
# polling). This script finds a running pet through its control socket and sends it a
# verb; it never starts a second copy. A Quickshell overlay left from CodePet 0.5 or
# earlier is stopped (exact PID, only when it reports no running task) before the native
# pet starts. CODEPET_PET_ENGINE=quickshell keeps the previous Quickshell overlay
# (described below) as a fallback for compositors the native pet cannot use.
#
# Quickshell engine: the overlay is one separate, detached `qs` process. This script finds
# a running instance and sends it an IPC verb; it never starts a second copy. `hide`,
# `refresh`, `status` and `quit` never start the overlay. `hide` only hides the pet;
# `quit` ends the overlay process (`qs kill`), for example before an uninstall.
#
# It refuses while a CodePet 0.2 simulation task is executing, and also when the
# overlay's status reply does not say (an empty reply, or one without the `supervisor`
# field, as from an overlay of CodePet 0.2.0). `quit --force` skips only that second
# refusal; it never ends an overlay reporting a running task. (The v0.3 installer does not
# use `quit`: it stops a running overlay by its exact PID before an upgrade.)
#
# v0.3: the desktop pet opens the bar popup itself, so the stub `panel` verb and the v0.2
# window verbs (`tasks`, `care`, `companion`, `life`) are gone (usage error). The pet does
# not stay while CodePet is Off ($XDG_STATE_HOME/codepet/off) or while "Pet on my desktop"
# is off: `show` and `toggle` then print why and exit 0 (CodePet notes.md section 9 item 5),
# never a timeout or a failed verb.
#
# Exit status: 0 success (status: running), 1 failure (status: not running),
# 2 usage error.
#
# Environment (all optional):
#   CODEPET_OVERLAY_QML  entry file (default: the installed current release)
#   CODEPET_BIN          codepet binary for the overlay (default ~/.local/bin/codepet)
#   CODEPET_QS           Quickshell CLI (default: qs)
#   CODEPET_PET          native pet binary (default: codepet-pet beside CODEPET_BIN)
#   CODEPET_PET_ENGINE   native (default) or quickshell
#   XDG_DATA_HOME, XDG_STATE_HOME are passed through unchanged (XDG_STATE_HOME also
#   locates CodePet's off flag).
#
# POSIX sh. Every expansion is quoted; nothing is evaluated.
set -u

PROG=codepet-overlay
TOKEN="codepet-overlay"

USAGE="usage: $PROG show|hide|toggle|refresh|status|card|quit [--force]"

usage() {
    echo "$USAGE" >&2
    exit 2
}

FORCE=0
case "$#" in
    1) ;;
    2) if [ "$1" = quit ] && [ "$2" = --force ]; then FORCE=1; else usage; fi ;;
    *) usage ;;
esac
VERB=$1
case "$VERB" in
    show|hide|toggle|refresh|status|card|quit) ;;
    -h|--help) echo "$USAGE"; exit 0 ;;
    *) usage ;;
esac

if [ -z "${HOME:-}" ]; then
    echo "$PROG: HOME is not set" >&2
    exit 1
fi

DATA_HOME=${XDG_DATA_HOME:-}
case "$DATA_HOME" in
    /*) ;;
    *) DATA_HOME="$HOME/.local/share" ;;
esac
CODEPET_DATA="$DATA_HOME/codepet"
QML=${CODEPET_OVERLAY_QML:-"$CODEPET_DATA/current/qml/shell.qml"}
BIN=${CODEPET_BIN:-"$HOME/.local/bin/codepet"}
WORK_LAUNCHER=${CODEPET_WORK_LAUNCHER:-}
if [ -z "$WORK_LAUNCHER" ]; then
    case "$BIN" in
        /*) WORK_LAUNCHER="${BIN%/*}/codepet-work" ;;
        *) WORK_LAUNCHER=codepet-work ;;
    esac
fi
export CODEPET_WORK_LAUNCHER="$WORK_LAUNCHER"
QS=${CODEPET_QS:-qs}
STATE_HOME=${XDG_STATE_HOME:-}
case "$STATE_HOME" in
    /*) ;;
    *) STATE_HOME="$HOME/.local/state" ;;
esac
OFF_FLAG="$STATE_HOME/codepet/off"
ENGINE=${CODEPET_PET_ENGINE:-native}
PET=${CODEPET_PET:-}
if [ -z "$PET" ]; then
    case "$BIN" in
        /*) PET="${BIN%/*}/codepet-pet" ;;
        *) PET=codepet-pet ;;
    esac
fi
case "$ENGINE" in
    native|quickshell) ;;
    *) echo "$PROG: unknown CODEPET_PET_ENGINE '$ENGINE' (native or quickshell)" >&2; exit 2 ;;
esac
# Without the native binary (an install older than 0.6, or a partial one), the
# Quickshell overlay is the pet.
if [ "$ENGINE" = native ] && ! command -v "$PET" >/dev/null 2>&1; then
    ENGINE=quickshell
fi

# Instance addressing: `-p <entry>` when the entry answers ping, otherwise
# `--pid <pid>` for an instance found by `qs list`.
TARGET_FLAG=
TARGET_VALUE=

# `--` is required: without it Quickshell 0.3.1 parses a function named like an
# ipc subcommand (`show`) as that subcommand and only lists the targets.
#
# ping <flag> <value>: true when that instance answers with the CodePet token.
ping_target() {
    reply=$("$QS" ipc "$1" "$2" call -- codepet ping 2>/dev/null) || return 1
    case "$reply" in
        "$TOKEN"*) return 0 ;;
        *) return 1 ;;
    esac
}

# Prints the pid of the first running CodePet overlay whose config path is under
# $CODEPET_DATA/current/ or $CODEPET_DATA/releases/ (an overlay started from an
# older release, or one too old to answer ping). `qs list --all --json` prints a
# JSON array with one "key": value per line, or "No running instances.".
find_listed_pid() {
    "$QS" list --all --json 2>/dev/null | CP_DATA="$CODEPET_DATA" awk '
        BEGIN {
            cur = ENVIRON["CP_DATA"] "/current/qml/shell.qml"
            rel = ENVIRON["CP_DATA"] "/releases/"
        }
        /^[ \t]*\{/ { path = ""; pid = "" }
        /"config_path"[ \t]*:/ {
            line = $0
            sub(/^[^:]*:[ \t]*"/, "", line)
            sub(/",?[ \t]*$/, "", line)
            path = line
        }
        /"pid"[ \t]*:/ {
            line = $0
            sub(/^[^:]*:[ \t]*/, "", line)
            sub(/,?[ \t]*$/, "", line)
            if (line ~ /^[0-9]+$/) pid = line
        }
        /^[ \t]*\}/ {
            tail = substr(path, length(rel) + 1)
            if (pid != "" && (path == cur || (index(path, rel) == 1 && tail ~ /^[^/]+\/qml\/shell\.qml$/))) {
                print pid
                exit
            }
        }'
}

# Sets TARGET_FLAG/TARGET_VALUE and succeeds when an overlay is running.
running() {
    if [ -f "$QML" ] && ping_target -p "$QML"; then
        TARGET_FLAG=-p
        TARGET_VALUE=$QML
        return 0
    fi
    pid=$(find_listed_pid)
    if [ -n "$pid" ]; then
        TARGET_FLAG=--pid
        TARGET_VALUE=$pid
        return 0
    fi
    return 1
}

# call <function>: sends one IPC verb to the selected instance.
call() {
    out=$("$QS" ipc "$TARGET_FLAG" "$TARGET_VALUE" call -- codepet "$1" 2>&1)
    rc=$?
    if [ "$rc" -ne 0 ]; then
        echo "$PROG: $1 failed: $out" >&2
        return 1
    fi
    case "$out" in
        "Function not found."*)
            echo "$PROG: the running overlay is from an older CodePet release and has no '$1'." >&2
            echo "$PROG: restart it once no task is executing." >&2
            return 1 ;;
    esac
    [ -n "$out" ] && printf '%s\n' "$out"
    return 0
}

# exit_if_off: CodePet is Off (the flag exists): say so and exit 0.
exit_if_off() {
    if [ -e "$OFF_FLAG" ]; then
        echo "$PROG: CodePet is off"
        exit 0
    fi
}

# exit_if_leaving: the selected overlay reports that it is about to exit (`exit_reason`
# in its status): say why and exit 0. An older overlay without the field says nothing.
exit_if_leaving() {
    st=$("$QS" ipc "$TARGET_FLAG" "$TARGET_VALUE" call -- codepet status 2>/dev/null) || st=
    case "$st" in
        *'"exit_reason":"off"'*)
            echo "$PROG: CodePet is off"
            exit 0 ;;
        *'"exit_reason":"desktop_pet_off"'*)
            echo "$PROG: the desktop pet is off"
            exit 0 ;;
    esac
}

start_overlay() {
    if [ ! -f "$QML" ]; then
        echo "$PROG: CodePet overlay is not installed ($QML is missing)" >&2
        return 1
    fi
    # -n refuses a duplicate of this config even if two launchers race.
    CODEPET_BIN="$BIN" "$QS" -n -d -p "$QML" >/dev/null 2>&1 || {
        echo "$PROG: could not start the overlay" >&2
        return 1
    }
    # Bounded readiness wait: 30 x 0.1 s.
    n=0
    while [ "$n" -lt 30 ]; do
        if ping_target -p "$QML"; then
            TARGET_FLAG=-p
            TARGET_VALUE=$QML
            return 0
        fi
        sleep 0.1
        n=$((n + 1))
    done
    echo "$PROG: the overlay did not answer within 3 s; see: $QS log -p $QML" >&2
    return 1
}

# ---- native engine ----

# pet_ctl <verb> [args]: one verb over the pet's control socket (stdout: its reply).
pet_ctl() {
    "$PET" ctl "$@" 2>/dev/null
}

# pet_running: true when a native pet answers ping with the launcher token.
pet_running() {
    reply=$(pet_ctl ping) || return 1
    case "$reply" in
        "$TOKEN"*) return 0 ;;
        *) return 1 ;;
    esac
}

# pet_leaving: the pet reports that it is about to exit: say why and exit 0.
pet_leaving() {
    st=$(pet_ctl status) || st=
    case "$st" in
        *'"exit_reason":"off"'*)
            echo "$PROG: CodePet is off"
            exit 0 ;;
        *'"exit_reason":"desktop_pet_off"'*)
            echo "$PROG: the desktop pet is off"
            exit 0 ;;
    esac
}

# legacy_stop: end a Quickshell overlay of CodePet 0.5 or earlier, so a native pet never
# runs beside it. Only an overlay reporting "supervisor":false is ended (fail closed).
legacy_stop() {
    command -v "$QS" >/dev/null 2>&1 || return 0
    running || return 0
    st=$("$QS" ipc "$TARGET_FLAG" "$TARGET_VALUE" call -- codepet status 2>/dev/null) || st=
    case "$st" in
        *'"supervisor":false'*) "$QS" kill "$TARGET_FLAG" "$TARGET_VALUE" >/dev/null 2>&1 || true ;;
    esac
}

if [ "$ENGINE" = native ]; then
    case "$VERB" in
        card)
            if [ ! -e "$OFF_FLAG" ] && pet_running; then
                st=$(pet_ctl status) || st=
                case "$st" in
                    *'"pet":"shown"'*) if pet_ctl openCard >/dev/null; then exit 0; fi ;;
                esac
            fi
            export CODEPET_BIN="$BIN"
            exec "$WORK_LAUNCHER" compact ;;
        status)
            if pet_running; then
                echo "running"
                pet_ctl status || true
                exit 0
            fi
            echo "not running"
            exit 1 ;;
        quit)
            if pet_running; then
                pet_ctl quit >/dev/null || true
                n=0
                while [ "$n" -lt 30 ] && pet_running; do
                    sleep 0.1
                    n=$((n + 1))
                done
                if pet_running; then
                    echo "$PROG: the desktop pet did not stop" >&2
                    exit 1
                fi
                exit 0
            fi
            echo "$PROG: overlay is not running; nothing to quit" >&2
            exit 0 ;;
        hide|refresh)
            if pet_running; then
                pet_ctl "$VERB" >/dev/null
                exit $?
            fi
            echo "$PROG: overlay is not running; nothing to $VERB" >&2
            exit 0 ;;
        *)
            # show and toggle. A pet started while CodePet is Off would exit at once.
            exit_if_off
            if pet_running; then
                pet_ctl "$VERB" >/dev/null || { exit_if_off; exit 1; }
            else
                legacy_stop
                # A fresh pet is already shown: a toggle from "not running" means show.
                CODEPET_BIN="$BIN" "$PET" start >/dev/null || {
                    exit_if_off
                    echo "$PROG: could not start the desktop pet ($PET)" >&2
                    exit 1
                }
            fi
            pet_leaving
            exit 0 ;;
    esac
fi

# ---- Quickshell engine (CODEPET_PET_ENGINE=quickshell) ----

if ! command -v "$QS" >/dev/null 2>&1; then
    echo "$PROG: Quickshell ($QS) is not installed" >&2
    exit 1
fi

case "$VERB" in
    card)
        # Opening controls never changes the user's desktop-pet visibility preference.
        if [ ! -e "$OFF_FLAG" ] && running; then
            st=$("$QS" ipc "$TARGET_FLAG" "$TARGET_VALUE" call -- codepet status 2>/dev/null) || st=
            case "$st" in
                *'"pet":"shown"'*) if call openCard; then exit 0; fi ;;
            esac
        fi
        export CODEPET_BIN="$BIN"
        exec "$WORK_LAUNCHER" compact ;;
    status)
        if running; then
            if [ "$TARGET_FLAG" = --pid ]; then
                echo "running (pid $TARGET_VALUE, older release path)"
            else
                echo "running"
            fi
            "$QS" ipc "$TARGET_FLAG" "$TARGET_VALUE" call -- codepet status 2>/dev/null || true
            exit 0
        fi
        echo "not running"
        exit 1 ;;
    quit)
        if running; then
            # Ending the overlay would interrupt a running simulation task's supervisor.
            # Fail closed: only an explicit "supervisor":false (or --force) lets it end.
            st=$("$QS" ipc "$TARGET_FLAG" "$TARGET_VALUE" call -- codepet status 2>/dev/null) || st=
            case "$st" in
                *'"supervisor":true'*)
                    echo "$PROG: a simulation task is executing; finish or cancel it in the CodePet 0.2 overlay's Tasks window, then quit" >&2
                    exit 1 ;;
                *'"supervisor":false'*) ;;
                *)
                    if [ "$FORCE" -ne 1 ]; then
                        echo "$PROG: the running overlay did not report whether a simulation task is executing (an overlay from CodePet 0.2.0 cannot)" >&2
                        echo "$PROG: finish or cancel any task in its Tasks window; then log out and back in, or run: $PROG quit --force" >&2
                        exit 1
                    fi ;;
            esac
            if "$QS" kill "$TARGET_FLAG" "$TARGET_VALUE" >/dev/null 2>&1; then
                exit 0
            fi
            echo "$PROG: could not stop the overlay ($QS kill $TARGET_FLAG $TARGET_VALUE failed)" >&2
            exit 1
        fi
        echo "$PROG: overlay is not running; nothing to quit" >&2
        exit 0 ;;
    hide|refresh)
        if running; then
            call "$VERB"
            exit $?
        fi
        echo "$PROG: overlay is not running; nothing to $VERB" >&2
        exit 0 ;;
    *)
        # show and toggle: an overlay started (or kept) while CodePet is Off would exit at
        # once, so none is started.
        exit_if_off
        if running; then
            call "$VERB" || { exit_if_off; exit 1; }
        else
            start_overlay || { exit_if_off; exit 1; }
            # A fresh overlay is already shown; a toggle from "not running" therefore
            # means show.
            case "$VERB" in
                toggle) call show ;;
                *) call "$VERB" ;;
            esac || { exit_if_off; exit 1; }
        fi
        exit_if_leaving
        exit 0 ;;
esac
